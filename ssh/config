# Hosts (names, addresses, users, keys) live in ~/.ssh/config.local, outside this public repo;
# it comes first so its per-host settings win over the defaults below
Include ~/.ssh/config.local

Host *
  # Only offer the key configured for a host, not every key in the agent
  IdentitiesOnly yes
  # known_hosts doesn't list where you connect in plain text (look up with ssh-keygen -F host)
  HashKnownHosts yes
  AddKeysToAgent yes
  UseKeychain yes
  SetEnv TERM="xterm-256color"
  # Reuse one connection per host for 10 minutes: repeated ssh/scp connect instantly
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist 10m
  # Drop a dead connection after 90 s instead of hanging
  ServerAliveInterval 30
  ServerAliveCountMax 3
