# Homebrew
if [[ -f /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="agnoster"
plugins=(git sudo safe-paste extract wd copyfile docker docker-compose fzf ssh zsh-interactive-cd)
source "$ZSH/oh-my-zsh.sh"

# zsh-autosuggestions
source "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
ZSH_AUTOSUGGEST_STRATEGY=(history)

# zsh-syntax-highlighting (must be last)
source "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# History
HISTSIZE=10000
SAVEHIST=10000
HISTFILE="$HOME/.zsh_history"
setopt HIST_FCNTL_LOCK HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY
setopt NO_APPEND_HISTORY NO_EXTENDED_HISTORY

# Tools
eval "$(zoxide init zsh)"
eval "$(direnv hook zsh)"

# Editor
export EDITOR=nvim
export VISUAL=nvim

# Aliases
alias c=clear
alias cdc='cd && clear'
alias s=sudo
alias sv='sudo nvim'
alias v=nvim
alias vim=nvim

# Functions
wz() {
  local interval="$1"; shift
  if [[ -z "$interval" || $# -eq 0 ]]; then echo "usage: wz <seconds> '<command>'"; return 1; fi
  watch -n "$interval" "zsh -lc $(printf '%q' "setopt aliases; source ~/.zshrc >/dev/null 2>&1; $*")"
}
mkcd() { mkdir -p "$1" && cd "$1"; }
trash() { mv "$@" ~/.Trash/; }
cheat() { curl -s "cht.sh/$1"; }
# Docker
export PATH=$PATH:~/.docker/bin
# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=(/Users/andreas/.docker/completions $fpath)
autoload -Uz compinit
compinit
# End of Docker CLI completions
